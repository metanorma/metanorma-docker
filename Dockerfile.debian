# syntax=docker/dockerfile:1
# Debian variant — the default Metanorma image, built the Docker-native
# way: a stock Ruby base image plus `bundle install` against the committed
# Gemfile.lock (BUNDLE_DEPLOYMENT at build time pins the whole dependency
# tree), compiled in-image with buildx for linux/amd64 and linux/arm64.
# The builder stage keeps the C toolchain out of the final image. ruby,
# gem and bundle stay on PATH, so the documented `bundle install` /
# `bundle exec metanorma` workflow for user Gemfiles keeps working.

# Base image tag. VERSION.mak is the single source of truth — the Makefile
# and CI pass it via --build-arg RUBY_VERSION. The default below is only a
# local-dev fallback.
ARG RUBY_VERSION=4.0.7

# ---------------------------------------------------------------------------
# Builder: compile the locked toolchain. Nothing here ships in the image.
# ---------------------------------------------------------------------------
FROM ruby:${RUBY_VERSION}-slim AS builder

USER root

ARG METANORMA_IMAGE_NAME=metanorma-debian

ENV DEBIAN_FRONTEND=noninteractive \
    BUNDLE_WITHOUT="development:test"

RUN mkdir -p /setup
COPY $METANORMA_IMAGE_NAME/Gemfile $METANORMA_IMAGE_NAME/Gemfile.lock /setup/
WORKDIR /setup

# Install build dependencies and compile the toolchain
RUN --mount=type=secret,id=bundle_config,dst=/usr/local/bundle/config \
    --mount=type=secret,id=gemrc_config,dst=$GEM_HOME/.gemrc \
    --mount=type=cache,target=/usr/local/bundle/cache \
    apt-get update && \
    apt-get --no-install-recommends install -y \
      make \
      gcc \
      g++ \
      cmake \
      libssl-dev \
      libxml2-dev \
      libxslt-dev \
      libffi-dev \
      libyaml-dev \
      zlib1g-dev && \
    BUNDLE_FROZEN=true bundle install && \
    find /usr/local/bundle/gems -type d -name 'spec' -prune -exec rm -r "{}" \; && \
    find /usr/local/bundle/gems -type d -name 'test' -prune -exec rm -r "{}" \;

# ---------------------------------------------------------------------------
# Runtime: the compiled toolchain plus host tools. No compiler, no headers.
# ---------------------------------------------------------------------------
FROM ruby:${RUBY_VERSION}-slim

USER root

LABEL maintainer="open.source@ribose.com" \
      org.opencontainers.image.authors="open.source@ribose.com" \
      org.opencontainers.image.url="https://www.metanorma.org" \
      org.opencontainers.image.documentation="https://www.metanorma.org" \
      org.opencontainers.image.title="Metanorma" \
      org.opencontainers.image.description="Metanorma document processing toolchain (Debian variant)"

ARG METANORMA_IMAGE_NAME=metanorma-debian

ENV DEBIAN_FRONTEND=noninteractive

# https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=863199#23
RUN mkdir -p /usr/share/man/man1

# Install runtime dependencies
RUN apt-get update && \
    apt-get --no-install-recommends install -y \
      ca-certificates \
      curl \
      git \
      gnupg2 \
      python3 \
      python3-lxml \
      openjdk-21-jre-headless \
      graphviz \
      tzdata \
      libxml2 \
      libxslt1.1 \
      libyaml-0-2 \
      libffi8 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install XML2RFC using a separate layer to minimize image size
ENV PYTHONUNBUFFERED=1
RUN --mount=type=cache,target=/root/.cache/pip \
    apt-get update && \
    apt-get --no-install-recommends install -y \
      python3-pip \
      python3-wheel \
      python3-setuptools && \
    pip3 install --break-system-packages \
      --upgrade pip wheel xml2rfc \
      --ignore-installed six chardet && \
    apt-get purge -y python3-pip python3-setuptools python3-wheel && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy the compiled toolchain and its lockfile
COPY --from=builder /usr/local/bundle /usr/local/bundle
COPY $METANORMA_IMAGE_NAME/Gemfile $METANORMA_IMAGE_NAME/Gemfile.lock /setup/

# Update fontist
RUN fontist update

# Set environment variables
# (No GEM_PATH override: it would drop Ruby's default-gem directory from
# the gem search path, which bundler 4 needs for stdlib gems like base64.)
ENV JAVA_HOME=/usr/lib/jvm/default-java \
    PATH=$PATH:/usr/lib/jvm/default-java/bin \
    RUBYOPT=-rbundler/setup \
    BUNDLE_GEMFILE=/setup/Gemfile \
    RELATON_FETCH_PARALLEL=1 \
    FONTIST_PATH="/config"

# Set up volume for fonts
VOLUME /config/fonts

# Set working directory
WORKDIR /metanorma

# Set default command
CMD ["metanorma"]
