# syntax=docker/dockerfile:1
# Debian variant — the default Metanorma image, built the Docker-native
# way: a stock Ruby base image plus `bundle install` against the committed
# Gemfile.lock (BUNDLE_DEPLOYMENT at build time pins the whole dependency
# tree), compiled in-image with buildx for linux/amd64 and linux/arm64.
# The builder stage keeps the full build stack out of the final image, but
# the runtime keeps the minimal toolchain needed to compile native gem
# extensions, so the documented `bundle install` / `bundle exec metanorma`
# workflow for user Gemfiles keeps working. ruby, gem and bundle stay on
# PATH.

# Base image tag. VERSION.mak is the single source of truth — the Makefile
# and CI pass it via --build-arg RUBY_VERSION. The default below is only a
# local-dev fallback.
ARG RUBY_VERSION=4.0.7

# ---------------------------------------------------------------------------
# Builder: compile the locked toolchain. Nothing here ships in the image.
# ---------------------------------------------------------------------------
FROM ruby:${RUBY_VERSION}-slim AS builder

USER root

ARG METANORMA_IMAGE_NAME=metanorma-debian

ENV DEBIAN_FRONTEND=noninteractive \
    BUNDLE_WITHOUT="development:test"

RUN mkdir -p /setup
COPY $METANORMA_IMAGE_NAME/Gemfile $METANORMA_IMAGE_NAME/Gemfile.lock /setup/
WORKDIR /setup

# Install build dependencies and compile the toolchain
RUN --mount=type=secret,id=bundle_config,dst=/usr/local/bundle/config \
    --mount=type=secret,id=gemrc_config,dst=$GEM_HOME/.gemrc \
    --mount=type=cache,target=/usr/local/bundle/cache \
    apt-get update && \
    apt-get --no-install-recommends install -y \
      make \
      gcc \
      g++ \
      cmake \
      libssl-dev \
      libxml2-dev \
      libxslt-dev \
      libffi-dev \
      libyaml-dev \
      zlib1g-dev && \
    BUNDLE_FROZEN=true bundle install && \
    find /usr/local/bundle/gems -type d -name 'spec' -prune -exec rm -r "{}" \; && \
    find /usr/local/bundle/gems -type d -name 'test' -prune -exec rm -r "{}" \;

# leptris ships its accelerated native read layer as per-minor compiled
# bundles inside the platform gem, but the currently published linux
# variants carry an incomplete set: aarch64-linux and both musl variants
# ship only native_3_3 — no native_4_0 for this image's ruby 4.0 — so
# leptris warns once per run and falls back to the slower FFI surface
# (the unversioned native.so is deliberately refused: wrong-ABI load,
# leptris-ruby#476; packaging gap tracked as leptris-ruby#645). Build the
# missing bundle for the image's ruby with the gem's own build script;
# a no-op for gems that shipped the complete set. Drop this once
# leptris-ruby#645 ships full linux platform gems.
RUN set -eux; \
    minor="$(ruby -e 'print RUBY_VERSION[/\A\d+\.\d+/].tr(".", "_")')"; \
    for d in /usr/local/bundle/gems/leptris-*/; do \
      [ -d "$d" ] || continue; \
      [ -f "${d}lib/leptris/xml/native_${minor}.so" ] || \
        ruby "${d}ext/build_native_per_minor.rb"; \
    done

# ---------------------------------------------------------------------------
# Runtime: the compiled toolchain plus host tools. No full build stack —
# only what native-gem extension compilation needs (see the apt run below).
# ---------------------------------------------------------------------------
FROM ruby:${RUBY_VERSION}-slim

USER root

LABEL maintainer="open.source@ribose.com" \
      org.opencontainers.image.authors="open.source@ribose.com" \
      org.opencontainers.image.url="https://www.metanorma.org" \
      org.opencontainers.image.documentation="https://www.metanorma.org" \
      org.opencontainers.image.title="Metanorma" \
      org.opencontainers.image.description="Metanorma document processing toolchain (Debian variant)"

ARG METANORMA_IMAGE_NAME=metanorma-debian

ENV DEBIAN_FRONTEND=noninteractive

# https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=863199#23
RUN mkdir -p /usr/share/man/man1

# Install runtime dependencies
# (apt-get upgrade pulls in security patchlevels of base packages — the
# Trivy gate fails the build on fixable HIGH/CRITICAL OS CVEs otherwise)
#
# The runtime also carries the minimal native-build toolchain (make, gcc,
# libc6-dev, libffi-dev): the documented `bundle install` workflow for
# user Gemfiles runs in-image, and current metanorma releases resolve
# default gems that compile from source at install time (bigdecimal, json,
# racc, strscan), while fiddle additionally needs libffi's headers.
# Without them every fresh user bundle dies on Gem::Ext::BuildError
# (metanorma-docker#270). libc6-dev is the C standard-library headers:
# gcc only recommends it, which --no-install-recommends drops. No g++:
# the metanorma stack ships no C++ extensions outside the precompiled
# platform gems.
RUN apt-get update && \
    apt-get --no-install-recommends install -y \
      ca-certificates \
      curl \
      git \
      gnupg2 \
      make \
      gcc \
      libc6-dev \
      libffi-dev \
      python3 \
      python3-lxml \
      openjdk-21-jre-headless \
      graphviz \
      tzdata \
      libxml2 \
      libxslt1.1 \
      libyaml-0-2 \
      libffi8 && \
    apt-get upgrade -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install XML2RFC using a separate layer to minimize image size
ENV PYTHONUNBUFFERED=1
RUN --mount=type=cache,target=/root/.cache/pip \
    apt-get update && \
    apt-get --no-install-recommends install -y \
      python3-pip \
      python3-wheel \
      python3-setuptools && \
    pip3 install --break-system-packages \
      --upgrade --upgrade-strategy eager pip wheel setuptools urllib3 msgpack xml2rfc \
      --ignore-installed six chardet && \
    apt-get purge -y python3-pip python3-setuptools python3-wheel && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy the compiled toolchain and its lockfile
COPY --from=builder /usr/local/bundle /usr/local/bundle
COPY $METANORMA_IMAGE_NAME/Gemfile $METANORMA_IMAGE_NAME/Gemfile.lock /setup/

# Update fontist
RUN fontist update

# Set environment variables
# (No GEM_PATH override: it would drop Ruby's default-gem directory from
# the gem search path, which bundler 4 needs for stdlib gems like base64.)
ENV JAVA_HOME=/usr/lib/jvm/default-java \
    PATH=$PATH:/usr/lib/jvm/default-java/bin \
    RUBYOPT=-rbundler/setup \
    BUNDLE_GEMFILE=/setup/Gemfile \
    RELATON_FETCH_PARALLEL=1 \
    FONTIST_PATH="/config"

# Set up volume for fonts
VOLUME /config/fonts

# Set working directory
WORKDIR /metanorma

# Set default command
CMD ["metanorma"]
