# Alpine variant — smallest-footprint gem build.
#
# Built the same Docker-native way as the Debian variant (Dockerfile.debian):
# a stock Ruby base image plus `bundle install` against the committed
# Gemfile.lock. Kept separate from the Debian variant because `musl` libc
# and the limited Alpine package set can constrain native-gem extensions.

# Base image tag. VERSION.mak is the single source of truth — CI passes it
# via --build-arg ALPINE_RUBY_VERSION. The default is a local-dev fallback.
ARG ALPINE_RUBY_VERSION=4.0.7
FROM ruby:${ALPINE_RUBY_VERSION}-alpine
USER root

LABEL maintainer="open.source@ribose.com" \
      org.opencontainers.image.authors="open.source@ribose.com" \
      org.opencontainers.image.url="https://www.metanorma.org" \
      org.opencontainers.image.documentation="https://www.metanorma.org" \
      org.opencontainers.image.title="Metanorma" \
      org.opencontainers.image.description="Metanorma document processing toolchain (Alpine variant)"

ARG METANORMA_IMAGE_NAME=metanorma-alpine

# Install runtime dependencies
# (apk upgrade pulls in security patchlevels of base packages — the
# Trivy gate fails the build on fixable HIGH/CRITICAL OS CVEs otherwise)
RUN apk add --no-cache \
    bash \
    coreutils \
    curl \
    fontconfig \
    git \
    gcompat \
    libxml2 \
    libxslt \
    make \
    nss \
    utf8proc \
    openjdk11-jre \
    openssl \
    ttf-dejavu \
    tzdata \
    unzip \
    graphviz \
    && apk upgrade --no-cache

# Install xml2rfc with optimized layer
ENV PYTHONUNBUFFERED=1
RUN --mount=type=cache,target=/root/.cache/pip \
    apk add --no-cache python3 py3-pip && \
    apk add --no-cache --virtual .build-deps \
        gcc \
        musl-dev \
        libxml2-dev \
        libxslt-dev \
        libffi-dev \
        python3-dev && \
    pip3 install --break-system-packages \
      --upgrade --upgrade-strategy eager pip wheel setuptools urllib3 msgpack xml2rfc \
      --ignore-installed six chardet && \
    apk del .build-deps

# Setup directory for app
RUN mkdir -p /setup

# Install metanorma toolchain with optimized layers
COPY $METANORMA_IMAGE_NAME/Gemfile $METANORMA_IMAGE_NAME/Gemfile.lock /setup/
WORKDIR /setup
ENV BUNDLE_WITHOUT="development:test"

# Use build dependencies in a single layer to reduce image size.
# The bundle-build step below covers leptris: its platform gems carry
# the accelerated native read layer as per-minor compiled bundles, but
# the currently published musl variants ship only native_3_3 — no
# native_4_0 for this image's ruby 4.0 — so leptris warns once per run
# and falls back to the slower FFI surface (the unversioned native.so
# is deliberately refused: wrong-ABI load, leptris-ruby#476; packaging
# gap tracked as leptris-ruby#645). Build the missing bundle for the
# image's ruby with the gem's own build script — inside this layer,
# before apk del removes gcc; a no-op for gems that shipped the
# complete set. Drop once leptris-ruby#645 ships full musl platform gems.
RUN --mount=type=secret,id=bundle_config,dst=/usr/local/bundle/config \
    --mount=type=cache,target=/usr/local/bundle/cache \
    apk add --no-cache --virtual .build-deps \
        gcc \
        g++ \
        musl-dev \
        cmake \
        openssl-dev \
        libxml2-dev \
        libxslt-dev \
        libffi-dev \
        yaml-dev \
        zlib-dev && \
    BUNDLE_FROZEN=true bundle install && \
    minor="$(ruby -e 'print RUBY_VERSION[/\A\d+\.\d+/].tr(".", "_")')" && \
    for d in /usr/local/bundle/gems/leptris-*/; do \
      [ -d "$d" ] || continue; \
      [ -f "${d}lib/leptris/xml/native_${minor}.so" ] || \
        ruby "${d}ext/build_native_per_minor.rb"; \
    done && \
    apk del .build-deps && \
    rm -rf /root/.bundle/cache && \
    find /usr/local/bundle/gems -type d -name 'spec' -prune -exec rm -r "{}" \; && \
    find /usr/local/bundle/gems -type d -name 'test' -prune -exec rm -r "{}" \;

# Update fontist
RUN fontist update

# Set environment variables
ENV JAVA_HOME=/usr/lib/jvm/default-jvm \
    PATH=$PATH:/usr/lib/jvm/default-jvm/bin \
    RUBYOPT=-rbundler/setup \
    BUNDLE_GEMFILE=/setup/Gemfile \
    RELATON_FETCH_PARALLEL=1 \
    FONTIST_PATH="/config"

# Set up volume for fonts
VOLUME /config/fonts

# Set working directory
WORKDIR /metanorma

# Set entrypoint
CMD ["metanorma"]
